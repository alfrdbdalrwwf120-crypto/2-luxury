# Token generated by @BotFather — never commit the real value.
BOT_TOKEN=replace_with_your_bot_token

# Optional display name used by the startup log.
BOT_NAME=دقة للتصميم

# Supabase project credentials
SUPABASE_URL=replace_with_your_supabase_url
SUPABASE_SERVICE_KEY=replace_with_your_supabase_secret_key

# Telegram numeric user ID(s) allowed to use /admin. Comma-separated for multiple admins.
ADMIN_IDS=replace_with_your_telegram_id

# Development defaults to long polling. Webhook support can be added later.
NODE_ENV=development
